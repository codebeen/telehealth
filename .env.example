POSTGRES_USER=telehealth
POSTGRES_PASSWORD=telehealth
POSTGRES_DB=telehealth
POSTGRES_PORT=5432

# Development mode
NODE_ENV=development
# Optional overrides
# NEXT_PUBLIC_API_URL=http://localhost:3001/api
# DATABASE_URL=postgres://telehealth:telehealth@postgres:5432/telehealth
# When running inside docker-compose dev, API host for frontend should be the service name:
# NEXT_PUBLIC_API_URL=http://api:3001/api

# Google Calendar / Meet integration for the API
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# GOOGLE_REDIRECT_URI=http://localhost:3001/google/callback
# GOOGLE_REFRESH_TOKEN=1//04xxxxxxxxxxxx
# GOOGLE_CALENDAR_TIMEZONE=Asia/Singapore
