// =============================================================================
// Model: Symptom
// Purpose: Lookup table for symptoms used in AI doctor recommendation.
// =============================================================================

model Symptom {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  specializationSymptoms SpecializationSymptom[]

  @@map("symptoms")
}

// =============================================================================
// Model: SpecializationSymptom
// Purpose: Maps symptoms → specializations for AI recommendation engine.
//          e.g. "Chest pain" → "Cardiology"
// =============================================================================

model SpecializationSymptom {
  id               String   @id @default(uuid()) @db.Uuid
  symptomId        String   @map("symptom_id") @db.Uuid
  specializationId String   @map("specialization_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  // Relations
  symptom        Symptom        @relation(fields: [symptomId], references: [id])
  specialization Specialization @relation(fields: [specializationId], references: [id])

  @@unique([symptomId, specializationId])
  @@map("specialization_symptoms")
}
